.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Secrets & API Keys
**/config/settings.json
*.env
*.env.local

# Heavy Pipeline Storage (Exclude gigabytes of video, separated stems, raw tts)
one_drama_engine/storage/raw_episodes/*
!one_drama_engine/storage/raw_episodes/.gitkeep
one_drama_engine/storage/audio_separated/*
!one_drama_engine/storage/audio_separated/.gitkeep
one_drama_engine/storage/tts_output/*
!one_drama_engine/storage/tts_output/.gitkeep
one_drama_engine/storage/processed_episodes/*
!one_drama_engine/storage/processed_episodes/.gitkeep
one_drama_engine/storage/master_export/*
!one_drama_engine/storage/master_export/.gitkeep
one_drama_engine/storage/voice_reference/*.wav
!one_drama_engine/storage/voice_reference/README.md
one_drama_engine/storage/archive_previous_run/
one_drama_engine/storage/previews/
one_drama_engine/storage/full_downloads/

# HuggingFace & PyTorch model caches
*.safetensors
*.bin
*.pt
*.onnx

one_drama_engine/scratch/*
scratch/*
